<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/w_root"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="horizontal" android:gravity="center_vertical"
  android:background="@drawable/widget_bg" android:padding="16dp">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal" android:paddingEnd="16dp">
    <TextView android:id="@+id/w_dow" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="#FFFFD27A" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="#FFFFFFFF" android:textSize="46sp" android:textStyle="bold" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/w_month" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_lunar" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="#FFFFD27A" android:textSize="17sp" android:textStyle="bold" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/w_can" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="#DDFFFFFF" android:textSize="12sp" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/w_hol" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="#FFFF9E8F" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="2dp" />
  </LinearLayout>
</LinearLayout>
